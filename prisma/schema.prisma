generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ── Users ──────────────────────────────────────────────────────
model User {
  id             Int      @id @default(autoincrement())
  fullName       String   @db.NVarChar(100)
  phone          String   @unique @db.VarChar(11)
  email          String?  @db.NVarChar(100)
  password       String   @db.NVarChar(255)
  academicYear   String?  @db.VarChar(20)
  role           String   @default("student") @db.VarChar(20)
  isActive       Boolean  @default(true)
  avatarUrl      String?  @db.NVarChar(500)
  whatsappNumber String?  @db.VarChar(20)
  balance        Float    @default(0)
  createdAt      DateTime @default(now())

  courses           Course[]           @relation("TeacherCourses")
  enrollments       Enrollment[]       @relation("StudentEnrollments")
  transactions      Transaction[]      @relation("StudentTransactions")
  topUpRequests     TopUpRequest[]     @relation("StudentTopUpRequests")
  processedTopUps   TopUpRequest[]     @relation("AdminTopUpRequests")
  examAttempts      ExamAttempt[]      @relation("StudentExamAttempts")
  progress          LessonProgress[]   @relation("StudentProgress")
  guardians         Guardian[]         @relation("StudentGuardians")
  teacherPermission TeacherPermission? @relation("TeacherPermissionRow")

  @@map("users")
}

model Guardian {
  id        Int      @id @default(autoincrement())
  fullName  String   @db.NVarChar(100)
  phone     String   @unique @db.VarChar(11)
  password  String   @db.NVarChar(255)
  createdAt DateTime @default(now())

  student   User @relation("StudentGuardians", fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  studentId Int

  @@map("guardians")
}

// ── Teacher Permissions ─────────────────────────────────────────
// One row per teacher. Missing row = defaults (see /api/teacher/permissions
// and the admin GET below, which both fill in defaults rather than requiring
// a row to exist for every teacher).
model TeacherPermission {
  id              Int      @id @default(autoincrement())
  canAddVideo     Boolean  @default(true)
  canAddExam      Boolean  @default(true)
  canEditContent  Boolean  @default(true)
  canViewStudents Boolean  @default(false)
  canReorder      Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  teacher   User @relation("TeacherPermissionRow", fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacherId Int  @unique

  @@map("teacher_permissions")
}

// ── Courses ────────────────────────────────────────────────────
model Course {
  id           Int      @id @default(autoincrement())
  name         String   @db.NVarChar(150)
  description  String?  @db.NVarChar(500)
  subject      String   @db.NVarChar(100)
  academicYear String   @db.VarChar(20)
  price        Float    @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())

  teacher   User? @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  teacherId Int?

  lessons       Lesson[]
  enrollments   Enrollment[]
  transactions  Transaction[]
  bankQuestions QuestionBank[]

  @@map("courses")
}

// ── Enrollments ────────────────────────────────────────────────
model Enrollment {
  id         Int      @id @default(autoincrement())
  enrolledAt DateTime @default(now())

  student   User @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int

  course   Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId Int

  @@unique([studentId, courseId])
  @@map("enrollments")
}

// ── Lessons ────────────────────────────────────────────────────
model Lesson {
  id        Int      @id @default(autoincrement())
  title     String   @db.NVarChar(200)
  type      String   @db.VarChar(10) // "video" | "exam"
  order     Int
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int

  video    Video?
  exam     Exam?
  progress LessonProgress[]

  @@map("lessons")
}

// ── Videos ─────────────────────────────────────────────────────

model Video {
  id          Int      @id @default(autoincrement())
  vimeoId     String   @db.NVarChar(100)
  description String?  @db.NVarChar(1000)
  createdAt   DateTime @default(now())

  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lessonId Int    @unique

  @@map("videos")
}

// ── Exams ──────────────────────────────────────────────────────
model Exam {
  id              Int       @id @default(autoincrement())
  durationMinutes Int?
  passingScore    Int       @default(50)
  scheduledAt     DateTime? // null = available immediately; future = locked until this time
  createdAt       DateTime  @default(now())

  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lessonId Int    @unique

  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  @@map("exams")
}

// ── Question Bank ───────────────────────────────────────────────
model QuestionBank {
  id            Int      @id @default(autoincrement())
  text          String   @db.NVarChar(500)
  type          String   @db.VarChar(15)
  optionsJson   String   @db.NVarChar(1000)
  correctAnswer String   @db.NVarChar(2000)
  lessonTag     String   @db.NVarChar(200)
  createdAt     DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int

  examQuestions ExamQuestion[]

  @@map("question_bank")
}

// ── Exam ↔ Question join ───────────────────────────────────────
model ExamQuestion {
  id        Int     @id @default(autoincrement())
  order     Int     @default(0)
  mark      Int     @default(1)
  isVisible Boolean @default(true)
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  examId    Int

  question   QuestionBank @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questionId Int

  answers AttemptAnswer[]

  @@unique([examId, questionId])
  @@map("exam_questions")
}

// ── Exam Attempts ──────────────────────────────────────────────
model ExamAttempt {
  id          Int       @id @default(autoincrement())
  score       Float?
  passed      Boolean?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  student   User @relation("StudentExamAttempts", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int

  exam   Exam @relation(fields: [examId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  examId Int

  answers AttemptAnswer[]

  @@map("exam_attempts")
}

// ── Attempt Answers ────────────────────────────────────────────
model AttemptAnswer {
  id          Int      @id @default(autoincrement())
  givenAnswer String   @db.NVarChar(Max)
  isCorrect   Boolean?
  gradedScore Float?
  graderNotes String?  @db.NVarChar(1000)

  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attemptId Int

  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  examQuestionId Int

  @@map("attempt_answers")
}

// ── Lesson Progress ────────────────────────────────────────────
model LessonProgress {
  id          Int       @id @default(autoincrement())
  completed   Boolean   @default(false)
  completedAt DateTime?

  student   User @relation("StudentProgress", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int

  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lessonId Int

  @@unique([studentId, lessonId])
  @@map("lesson_progress")
}

// ── Center Settings (singleton row, id = 1) ──────────────────────
model CenterSettings {
  id                  Int      @id @default(autoincrement())
  siteName            String   @default("EduCenter") @db.NVarChar(150)
  siteDescription     String?  @db.NVarChar(500)
  email               String?  @db.NVarChar(150)
  phone               String?  @db.VarChar(20)
  whatsappNumber      String?  @db.VarChar(20)
  address             String?  @db.NVarChar(300)
  facebookUrl         String?  @db.NVarChar(300)
  instagramUrl        String?  @db.NVarChar(300)
  youtubeUrl          String?  @db.NVarChar(300)
  whatsappButtonLabel String?  @db.NVarChar(100)
  copyrightText       String?  @db.NVarChar(200)
  updatedAt           DateTime @updatedAt

  @@map("center_settings")
}

// ── Top-Up Requests ────────────────────────────────────────────
// The workflow/review side of a balance top-up. Lives entirely on its own:
// created by a student, reviewed by an admin, and never represents money
// that has actually moved yet. Approving one produces exactly one
// Transaction row (see below); rejecting one produces none.

model TopUpRequest {
  id            Int       @id @default(autoincrement())
  amount        Float
  method        String    @db.VarChar(20) // "cash" | "wallet" | "fawry"
  status        String    @default("pending") @db.VarChar(20) // "pending" | "approved" | "rejected"
  senderPhone   String?   @db.VarChar(20) // required for "wallet"
  proofImageUrl String?   @db.NVarChar(500) // required for "wallet"
  notes         String?   @db.NVarChar(300)
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  student   User @relation("StudentTopUpRequests", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int

  processedBy   User? @relation("AdminTopUpRequests", fields: [processedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  processedById Int?

  // Changed from `transaction Transaction?` to Transaction[]: Prisma
  // requires @unique on the FK side for a true 1:1 relation, but we
  // deliberately don't put a plain @unique on Transaction.topUpRequestId
  // (SQL Server would then reject a second NULL from purchase/adjustment
  // rows). So both sides of this relation are modeled as 1:many at the
  // Prisma level; "at most one" is enforced for real by the filtered
  // unique index on transactions.topUpRequestId (already applied to the
  // DB) rather than by Prisma's type system. In practice this array will
  // only ever contain zero or one element.
  transactions Transaction[]

  @@map("topup_requests")
}

// ── Transactions ───────────────────────────────────────────────
// Pure, append-only ledger: a row exists here if and only if the student's
// balance actually changed. No pending/rejected states, no unused columns
// depending on row type — if it's here, it happened.
//
// topUpRequestId is intentionally NOT @unique at the Prisma level anymore.
// SQL Server treats a plain unique constraint as allowing only ONE null
// across the whole table — but every "purchase" and "adjustment" row
// leaves this column null, so a second one would falsely collide with
// the first. The real uniqueness ("at most one transaction per top-up
// request, when one exists") is instead enforced by a filtered unique
// index created directly in the migration SQL below.
model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Float
  type      String   @db.VarChar(20) // "topup" | "purchase" | "adjustment"
  method    String   @db.VarChar(20) // "cash" | "wallet" | "fawry" | "balance" | "manual"
  notes     String?  @db.NVarChar(300)
  createdAt DateTime @default(now())

  student   User @relation("StudentTransactions", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int

  // Set for "purchase" transactions only.
  course   Course? @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId Int?

  // Set for "topup" transactions only — traces back to the request that
  // was approved to create this ledger entry. Enforced unique (when not
  // null) via a filtered index in migration SQL, not @unique here.
  topUpRequest   TopUpRequest? @relation(fields: [topUpRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topUpRequestId Int?

  @@map("transactions")
}
