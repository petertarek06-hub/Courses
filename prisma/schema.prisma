generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ── Users ──────────────────────────────────────────────────────
model User {
  id             Int      @id @default(autoincrement())
  fullName       String   @db.NVarChar(100)
  phone          String   @unique @db.VarChar(11)
  email          String?  @db.NVarChar(100)
  password       String   @db.NVarChar(255)
  academicYear   String?  @db.VarChar(20)
  role           String   @default("student") @db.VarChar(20)
  isActive       Boolean  @default(true)
  avatarUrl      String?  @db.NVarChar(500)
  whatsappNumber String?  @db.VarChar(20)
  balance        Float    @default(0)
  createdAt      DateTime @default(now())

  courses           Course[]           @relation("TeacherCourses")
  enrollments       Enrollment[]       @relation("StudentEnrollments")
  subscriptions     Subscription[]     @relation("StudentSubscriptions")
  transactions      Transaction[]      @relation("StudentTransactions")
  topUpRequests     TopUpRequest[]     @relation("StudentTopUpRequests")
  processedTopUps   TopUpRequest[]     @relation("AdminTopUpRequests")
  examAttempts      ExamAttempt[]      @relation("StudentExamAttempts")
  scheduledExamAttempts ScheduledExamAttempt[] @relation("StudentScheduledExamAttempts")
  progress          LessonProgress[]   @relation("StudentProgress")
  guardians         Guardian[]         @relation("StudentGuardians")
  teacherPermission TeacherPermission? @relation("TeacherPermissionRow")

  @@map("users")
}

model Guardian {
  id        Int      @id @default(autoincrement())
  fullName  String   @db.NVarChar(100)
  phone     String   @unique @db.VarChar(11)
  password  String   @db.NVarChar(255)
  createdAt DateTime @default(now())

  student   User @relation("StudentGuardians", fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  studentId Int

  @@map("guardians")
}

// ── Teacher Permissions ─────────────────────────────────────────
model TeacherPermission {
  id              Int      @id @default(autoincrement())
  canAddVideo     Boolean  @default(true)
  canAddExam      Boolean  @default(true)
  canEditContent  Boolean  @default(true)
  canViewStudents Boolean  @default(false)
  canReorder      Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  teacher   User @relation("TeacherPermissionRow", fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacherId Int  @unique

  @@map("teacher_permissions")
}

// ── Courses ────────────────────────────────────────────────────
model Course {
  id                Int      @id @default(autoincrement())
  name              String   @db.NVarChar(150)
  description       String?  @db.NVarChar(500)
  subject           String   @db.NVarChar(100)
  academicYear      String   @db.VarChar(20)
  price             Float    @default(0)
  subscriptionPrice Float?   @db.Float
  isVisible         Boolean  @default(true)
  createdAt         DateTime @default(now())
  teacher   User? @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  teacherId Int?
  lessons         Lesson[]
  enrollments     Enrollment[]
  subscriptions   Subscription[]
  transactions    Transaction[]
  bankQuestions   QuestionBank[]
  units           Unit[]
  topics          Topic[]
  scheduledExams  ScheduledExam[] @relation("CourseScheduledExams")

  @@map("courses")
}
model Enrollment {
  id              Int      @id @default(autoincrement())
  enrolledAt      DateTime @default(now())
  enrollmentType  String   @default("full") @db.VarChar(20) // "full" or "subscription"
  student   User @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId Int
  subscription   Subscription? @relation("EnrollmentSubscription", fields: [subscriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptionId Int? @unique
  @@unique([studentId, courseId])
  @@map("enrollments")
}

model Subscription {
  id              Int      @id @default(autoincrement())
  startDate       DateTime @default(now())
  nextBillingDate  DateTime
  isActive        Boolean  @default(true)
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  student   User @relation("StudentSubscriptions", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId Int
  enrollment   Enrollment? @relation("EnrollmentSubscription")
  transactions Transaction[] @relation("SubscriptionTransactions")
  @@map("subscriptions")
}
model Unit {
  id        Int      @id @default(autoincrement())
  title     String   @db.NVarChar(200)
  order     Int
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int

  lessons Lesson[] // videos and exams both, in one shared per-unit sequence

  @@map("units")
}
model Lesson {
  id        Int      @id @default(autoincrement())
  title     String   @db.NVarChar(200)
  type      String   @db.VarChar(10) // "video" | "exam"
  order     Int      // position within the unit — shared sequence across videos AND exams
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int

  // Every lesson now belongs to a unit — videos and exams alike.
  // NoAction (not Cascade): deleting a Unit never cascades to its lessons —
  // the /api/admin/units DELETE route already refuses to delete a unit
  // that still has lessons, so this path should never be exercised.
  unit   Unit @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitId Int

  video    Video?
  exam     Exam?
  progress LessonProgress[]

  @@map("lessons")
}
// ── Videos ─────────────────────────────────────────────────────
model Video {
  id          Int      @id @default(autoincrement())
  vimeoId     String   @db.NVarChar(100)
  description String?  @db.NVarChar(1000)
  createdAt   DateTime @default(now())

  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lessonId Int    @unique

  @@map("videos")
}

// ── Exams ──────────────────────────────────────────────────────
// Lesson-based quizzes (part of the learning sequence)
model Exam {
  id              Int       @id @default(autoincrement())
  durationMinutes Int?
  passingScore    Int       @default(50)
  createdAt       DateTime  @default(now())
  scheduledAt     DateTime? @map("scheduled_at")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lessonId Int    @unique

  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  @@map("exams")
}

// ── Scheduled Exams ─────────────────────────────────────────────
// Independent exams scheduled at specific times, decoupled from lesson sequence
model ScheduledExam {
  id              Int       @id @default(autoincrement())
  title           String    @db.NVarChar(200)
  durationMinutes Int?
  passingScore    Int       @default(50)
  scheduledAt     DateTime  // Required - this is what makes it a scheduled exam
  isVisible       Boolean   @default(true)
  createdAt       DateTime  @default(now())

  course   Course @relation("CourseScheduledExams", fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int

  examQuestions ScheduledExamQuestion[]
  attempts      ScheduledExamAttempt[]

  @@map("scheduled_exams")
}

// ── Topics ─────────────────────────────────────────────────────
// Per-course list of topics, replacing the old free-text lessonTag.
model Topic {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(200)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int

  questions QuestionBank[]

  @@unique([courseId, name])
  @@map("topics")
}

// ── Question Bank ───────────────────────────────────────────────
model QuestionBank {
  id            Int      @id @default(autoincrement())
  text          String   @db.NVarChar(500)
  type          String   @db.VarChar(15)
  optionsJson   String   @db.NVarChar(1000)
  correctAnswer String   @db.NVarChar(2000)
  createdAt     DateTime @default(now())

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courseId Int

  topic   Topic @relation(fields: [topicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topicId Int

  examQuestions ExamQuestion[]
  scheduledExamQuestions ScheduledExamQuestion[]

  @@map("question_bank")
}

// ── Exam ↔ Question join ───────────────────────────────────────
model ExamQuestion {
  id        Int     @id @default(autoincrement())
  order     Int     @default(0)
  mark      Int     @default(1)
  isVisible Boolean @default(true)
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  examId    Int

  question   QuestionBank @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questionId Int

  answers AttemptAnswer[]

  @@unique([examId, questionId])
  @@map("exam_questions")
}

// ── Scheduled Exam ↔ Question join ─────────────────────────────
model ScheduledExamQuestion {
  id        Int     @id @default(autoincrement())
  order     Int     @default(0)
  mark      Int     @default(1)
  isVisible Boolean @default(true)
  exam      ScheduledExam @relation(fields: [examId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  examId    Int

  question   QuestionBank @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questionId Int

  answers ScheduledExamAttemptAnswer[]

  @@unique([examId, questionId])
  @@map("scheduled_exam_questions")
}

// ── Exam Attempts ──────────────────────────────────────────────
model ExamAttempt {
  id          Int       @id @default(autoincrement())
  score       Float?
  passed      Boolean?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  student   User @relation("StudentExamAttempts", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int

  exam   Exam @relation(fields: [examId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  examId Int

  answers AttemptAnswer[]

  @@map("exam_attempts")
}

// ── Attempt Answers ────────────────────────────────────────────
model AttemptAnswer {
  id          Int      @id @default(autoincrement())
  givenAnswer String   @db.NVarChar(Max)
  isCorrect   Boolean?
  gradedScore Float?
  graderNotes String?  @db.NVarChar(1000)

  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attemptId Int

  examQuestion   ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  examQuestionId Int

  @@map("attempt_answers")
}

// ── Scheduled Exam Attempts ────────────────────────────────────
model ScheduledExamAttempt {
  id          Int       @id @default(autoincrement())
  score       Float?
  passed      Boolean?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  student   User @relation("StudentScheduledExamAttempts", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int

  exam   ScheduledExam @relation(fields: [examId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  examId Int

  answers ScheduledExamAttemptAnswer[]

  @@map("scheduled_exam_attempts")
}

// ── Scheduled Exam Attempt Answers ─────────────────────────────
model ScheduledExamAttemptAnswer {
  id          Int      @id @default(autoincrement())
  givenAnswer String   @db.NVarChar(Max)
  isCorrect   Boolean?
  gradedScore Float?
  graderNotes String?  @db.NVarChar(1000)

  attempt   ScheduledExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attemptId Int

  examQuestion   ScheduledExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  examQuestionId Int

  @@unique([attemptId, examQuestionId])
  @@map("scheduled_exam_attempt_answers")
}

// ── Lesson Progress ────────────────────────────────────────────
model LessonProgress {
  id          Int       @id @default(autoincrement())
  completed   Boolean   @default(false)
  completedAt DateTime?

  student   User @relation("StudentProgress", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int

  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lessonId Int

  @@unique([studentId, lessonId])
  @@map("lesson_progress")
}

// ── Center Settings (singleton row, id = 1) ──────────────────────
// ── Center Settings (singleton row, id = 1) ──────────────────────
model CenterSettings {
  id                  Int      @id @default(autoincrement())
  siteName            String   @default("EduCenter") @db.NVarChar(150)
  siteDescription     String?  @db.NVarChar(500)
  email               String?  @db.NVarChar(150)
  phone               String?  @db.VarChar(20)
  whatsappNumber      String?  @db.VarChar(20)
  address             String?  @db.NVarChar(300)
  facebookUrl         String?  @db.NVarChar(300)
  instagramUrl        String?  @db.NVarChar(300)
  youtubeUrl          String?  @db.NVarChar(300)
  whatsappButtonLabel String?  @db.NVarChar(100)
  copyrightText       String?  @db.NVarChar(200)
  // ── Footer special offer ──
  offerEnabled        Boolean  @default(false)
  offerTitle          String?  @db.NVarChar(200)
  offerText           String?  @db.NVarChar(500)
  offerImageUrl       String?  @db.NVarChar(500)
  updatedAt           DateTime @updatedAt

  @@map("center_settings")
}
// ── Top-Up Requests ────────────────────────────────────────────
model TopUpRequest {
  id            Int       @id @default(autoincrement())
  amount        Float
  method        String    @db.VarChar(20)
  status        String    @default("pending") @db.VarChar(20)
  senderPhone   String?   @db.VarChar(20)
  proofImageUrl String?   @db.NVarChar(500)
  notes         String?   @db.NVarChar(300)
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  student   User @relation("StudentTopUpRequests", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int

  processedBy   User? @relation("AdminTopUpRequests", fields: [processedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  processedById Int?

  transactions Transaction[]

  @@map("topup_requests")
}

// ── Transactions ───────────────────────────────────────────────
model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Float
  type      String   @db.VarChar(20)
  method    String   @db.VarChar(20)
  notes     String?  @db.NVarChar(300)
  createdAt DateTime @default(now())

  student   User @relation("StudentTransactions", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentId Int

  course   Course? @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId Int?

  topUpRequest   TopUpRequest? @relation(fields: [topUpRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  topUpRequestId Int?

  subscription   Subscription? @relation("SubscriptionTransactions", fields: [subscriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptionId Int?

  @@map("transactions")
}